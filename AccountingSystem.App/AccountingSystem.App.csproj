<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccountingSystem.App</RootNamespace>
    <AssemblyName>AccountingSystem</AssemblyName>
    <ApplicationIcon>NMS Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="NMS Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the logo to output so the UI can load it at runtime without embedding. -->
    <!-- Support both NMS_logo.png and nms.png filenames if present -->
    <Content Include="Resources\NMS_logo.png" Condition="Exists('Resources\\NMS_logo.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\nms.png" Condition="Exists('Resources\\nms.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ChartOfAccounts.seed.sql" />
    <EmbeddedResource Include="Resources\JournalEntries.seed.sql" />
  </ItemGroup>

</Project>
