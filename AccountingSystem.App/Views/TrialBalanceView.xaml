<UserControl x:Class="AccountingSystem.App.Views.TrialBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="From"/>
            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130"/>
            <Label Content="To"/>
            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="90"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
            <TextBlock FontWeight="Bold" Margin="0,0,24,0">
                <Run Text="Total Debit: "/>
                <Run Text="{Binding TotalDebit, StringFormat={}{0:N2}}"/>
            </TextBlock>
            <TextBlock FontWeight="Bold">
                <Run Text="Total Credit: "/>
                <Run Text="{Binding TotalCredit, StringFormat={}{0:N2}}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
