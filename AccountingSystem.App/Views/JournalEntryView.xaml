<UserControl x:Class="AccountingSystem.App.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,8" BorderBrush="#D0D0D0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="New Journal Line" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel>
                        <Label Content="Date"/>
                        <DatePicker SelectedDate="{Binding EntryDate, Mode=TwoWay}" Width="130"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Voucher No."/>
                        <TextBox Text="{Binding VoucherNo, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Account"/>
                        <ComboBox ItemsSource="{Binding AvailableAccounts}"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  DisplayMemberPath="."
                                  Width="240"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Description"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Debit"/>
                        <TextBox Text="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Credit"/>
                        <TextBox Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Line" Command="{Binding AddCommand}"/>
                    <Button Content="Start New Voucher" Command="{Binding NewVoucherCommand}"/>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold">
                        <Run Text="Journal out-of-balance total: "/>
                        <Run Text="{Binding OutOfBalance, StringFormat={}{0:N2}}"/>
                        <Run Text=" (should be 0.00)"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filter panel -->
        <Border Grid.Row="1" Padding="8" Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Margin="4">
                    <Label Content="From"/>
                    <DatePicker SelectedDate="{Binding FilterFrom, Mode=TwoWay}" Width="130"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <Label Content="To"/>
                    <DatePicker SelectedDate="{Binding FilterTo, Mode=TwoWay}" Width="130"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <Label Content="Account"/>
                    <ComboBox ItemsSource="{Binding FilterAccounts}"
                              SelectedItem="{Binding FilterAccount, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="220"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8">
                    <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Margin="4"/>
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}" Margin="4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                <DataGridTextColumn Header="V.No" Binding="{Binding VoucherNo}" Width="60"/>
                <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="90"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="180"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,8,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold">
                <Run Text="Total Debit: "/>
                <Run Text="{Binding TotalDebit, StringFormat={}{0:N2}}"/>
            </TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold">
                <Run Text="Total Credit: "/>
                <Run Text="{Binding TotalCredit, StringFormat={}{0:N2}}"/>
            </TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold">
                <Run Text="Closing Balance: "/>
                <Run Text="{Binding ClosingBalance, StringFormat={}{0:N2}}"/>
            </TextBlock>
            <Button Content="Delete Selected Line" Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
