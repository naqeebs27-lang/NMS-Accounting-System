<Window x:Class="AccountingSystem.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountingSystem.App.Views"
        xmlns:vm="clr-namespace:AccountingSystem.App.ViewModels"
        Title="Accounting System — Command Dashboard" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16,12">
            <TextBlock Text="ACCOUNTING SYSTEM — COMMAND DASHBOARD"
                       Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="8">
            <TabItem Header="Naqeebs Accounting">
                <local:DashboardView/>
            </TabItem>
            <TabItem Header="Chart of Accounts">
                <local:ChartOfAccountsView DataContext="{Binding ChartOfAccounts}"/>
            </TabItem>
            <TabItem Header="Journal Entries">
                <local:JournalEntryView DataContext="{Binding JournalEntries}"/>
            </TabItem>

            <TabItem Header="Ledger">
                <local:LedgerView DataContext="{Binding Ledger}"/>
            </TabItem>
            <TabItem Header="Trial Balance">
                <local:TrialBalanceView DataContext="{Binding TrialBalance}"/>
            </TabItem>
            <TabItem Header="Income Statement">
                <local:IncomeStatementView DataContext="{Binding IncomeStatement}"/>
            </TabItem>
            <TabItem Header="Balance Sheet">
                <local:BalanceSheetView DataContext="{Binding BalanceSheet}"/>
            </TabItem>
            <TabItem Header="Petty Cash">
                <local:PettyCashView DataContext="{Binding PettyCash}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
