<UserControl x:Class="AccountingSystem.App.Views.IncomeStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="From"/>
            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130"/>
            <Label Content="To"/>
            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/>
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="140"/>
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="140"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Margin="0,8,8,0">
            <Run Text="Total Expense: "/>
            <Run Text="{Binding TotalExpense, StringFormat={}{0:N2}}"/>
        </TextBlock>
    </Grid>
</UserControl>
