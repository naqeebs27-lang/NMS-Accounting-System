<UserControl x:Class="AccountingSystem.App.Views.PettyCashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Label Content="From"/>
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130"/>
                <Label Content="To" Margin="8,0,0,0"/>
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                <Button Content="Generate Monthly Total" Command="{Binding GeneratePettyCommand}" Margin="8,0,0,0"/>
                <Button Content="Post Summary to Journal" Command="{Binding PostPettyCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Add Petty Cash Entry" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Date" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding NewEntryDate, Mode=TwoWay}" Width="130"/>
                            <Label Content="Description" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <Label Content="Account" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ExpenseAccounts}" DisplayMemberPath="Name" SelectedValuePath="AccountId" SelectedValue="{Binding SelectedExpenseAccountId, Mode=TwoWay}" Width="180"/>
                            <Label Content="Type" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding EntryTypes}" SelectedItem="{Binding EntryType, Mode=TwoWay}" Width="95"/>
                            <Label Content="Receipt" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReceiptAmount, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <Label Content="Payment" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <Button Content="Add Entry" Command="{Binding AddEntryCommand}" Margin="8,0,0,0"/>
                            <Button Content="Update Entry" Command="{Binding UpdateEntryCommand}" Margin="8,0,0,0"/>
                            <Button Content="Delete Entry" Command="{Binding DeleteEntryCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <GroupBox Header="Monthly Petty Cash Expenses" Margin="0,8,0,0">
                <DataGrid ItemsSource="{Binding MonthlySummary}" AutoGenerateColumns="False" Height="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Expense Head" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ExpenseEntries}" AutoGenerateColumns="False" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNo}" Width="80"/>
                <DataGridTextColumn Header="Expense Account" Binding="{Binding AccountName}" Width="180"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="Total Debit:"/>
                <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="Total Credit:"/>
                <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="Closing Balance:"/>
                <TextBlock Text="{Binding ClosingBalance, StringFormat=N2}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                <TextBlock Text="Monthly Petty Total:"/>
                <TextBlock Text="{Binding PettyMonthlyTotal, StringFormat=N2}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>