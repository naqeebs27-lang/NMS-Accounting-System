## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
.vs/

# Build results
bin/
obj/
publish/
installer/

# Visual Studio cache/options
*.user
*.suo
*.userosscache
*.sln.docstates

# JetBrains Rider
.idea/

# NuGet
*.nupkg
.nuget/

# VS Code
.vscode/

# Logs
*.log

# OS
Thumbs.db
.DS_Store
